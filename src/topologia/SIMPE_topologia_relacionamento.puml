@startuml
left to right direction
skinparam componentStyle rectangle

actor "Usuário\nGestor / Professor / Coordenador / Assistente Social" as Usuario
rectangle "PC0-Gestor\n192.168.1.11\nMasc: 255.255.255.0" as Gestor
rectangle "PC1-Coordenador\n192.168.1.12\nMasc: 255.255.255.0" as Coordenador
rectangle "PC2-Professor\n192.168.1.13\nMasc: 255.255.255.0" as Professor
rectangle "PC3-Assistente_Social\n192.168.1.14\nMasc: 255.255.255.0" as Social
rectangle "Switch\nRede SIMPE\n192.168.1.0/24" as Switch
rectangle "Servidor APP\nSIMPE Backend\n192.168.1.10\nMasc: 255.255.255.0\nGW: 192.168.1.1" as AppServer
rectangle "Servidor DB\nSQLite simpe.db\n192.168.1.15\nMasc: 255.255.255.0\nGW: 192.168.1.1" as DbServer

Usuario --> Gestor
Usuario --> Coordenador
Usuario --> Professor
Usuario --> Social
Gestor --> Switch
Coordenador --> Switch
Professor --> Switch
Social --> Switch
Switch --> AppServer
Switch --> DbServer
AppServer --> DbServer : consulta / persistência

note right of DbServer
Tabela SIMPE:
Perfil, Usuario,
Responsavel, Curso,
Turma, Aluno,
Disciplina,
Frequencia,
Nota, Ocorrencia,
Intervencao,
Alerta,
Configuracao_Risco
end note
@enduml
